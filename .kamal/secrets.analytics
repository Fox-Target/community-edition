SECRET_KEY_BASE=$(dcli read dl://plausible-secret-key-base/password)

POSTGRES_PASSWORD=$(dcli read dl://plausible-postgres-password/password)
# Construite à partir de la ligne ci-dessus (la substitution est séquentielle),
# pour que le mot de passe n'existe qu'à un seul endroit : Dashlane.
DATABASE_URL=postgres://postgres:$POSTGRES_PASSWORD@plausible-db:5432/plausible_db

GOOGLE_CLIENT_ID=$(dcli read dl://plausible-google-client-id/password)
GOOGLE_CLIENT_SECRET=$(dcli read dl://plausible-google-client-secret/password)
